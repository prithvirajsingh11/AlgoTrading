# AlgoTrade Environment Configuration Example
PROJECT_NAME="AlgoTrade"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="algotrade"
POSTGRES_PASSWORD="algotrade_password"
POSTGRES_DB="algotrade_db"
DATABASE_URL="postgresql+asyncpg://algotrade:algotrade_password@localhost:5432/algotrade_db"

# Trading Defaults
DEFAULT_INITIAL_CAPITAL=100000.0
DEFAULT_COMMISSION_FIXED=1.0
DEFAULT_COMMISSION_PERCENT=0.0005
DEFAULT_SLIPPAGE_BPS=5.0
