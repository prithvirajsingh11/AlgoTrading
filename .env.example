# AlgoTrade Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

PROJECT_NAME="AlgoTrade — ML-Enhanced Algorithmic Trading & Backtesting Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Persistence (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="sqlite+aiosqlite:///./data/algotrade.db"

# Trading Defaults
DEFAULT_INITIAL_CAPITAL=100000.0
DEFAULT_COMMISSION_FIXED=1.0
DEFAULT_COMMISSION_PERCENT=0.0005
DEFAULT_SLIPPAGE_BPS=5.0

# Resource Safeguards
MAX_DATASET_ROWS=500000
MAX_SWEEP_COMBINATIONS=100
MAX_CONCURRENT_EXPERIMENTS=10
MAX_PAPER_SESSIONS=25
CORS_ORIGINS="*"

# Jev AI Decision Layer (TypeSafe SystemOne)
# Keep JEV_ENABLED=false for baseline quantitative research mode without external API dependency.
JEV_ENABLED=false
JEV_API_KEY=""
JEV_MODEL="jev-latest"
JEV_TIMEOUT_SECONDS=5.0
JEV_MIN_CONFIDENCE=0.60
JEV_API_URL="https://api.typesafe.ai/v1/systemone"
